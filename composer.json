{
  "name": "portfolio/soknadssystem",
  "description": "Et enkelt søknadssystem i PHP.",
  "type": "project",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.56",
    "phpunit/phpunit": "^10.5"
  },
  "scripts": {
    "lint": "php -l $(git ls-files '*.php')",
    "format": "php-cs-fixer fix",
    "format:check": "php-cs-fixer fix --dry-run --diff",
    "test": "phpunit"
  }
}
